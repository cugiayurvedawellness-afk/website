# EmailJS Configuration
# Get your Public Key from: https://www.emailjs.com/docs/user-guide/
REACT_APP_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY_HERE

# EmailJS Service ID (create in EmailJS dashboard)
REACT_APP_EMAILJS_SERVICE_ID=service_ayurvedic

# EmailJS Template ID for booking confirmation emails
REACT_APP_EMAILJS_TEMPLATE_ID=template_booking_confirmation

# Admin email address where booking notifications are sent
REACT_APP_ADMIN_EMAIL=admin@ayurvedicretreat.com
